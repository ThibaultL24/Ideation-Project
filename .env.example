# =============================================================================
# Hunch Ideation Dapp — environment reference
# Copy to `.env` and adjust. Run `npm run env:check` to verify resolved values.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) APP URL (required for GitHub OAuth redirects)
# -----------------------------------------------------------------------------
# Public URL where users open the dapp. Must match your GitHub OAuth App settings.
# Local dev (WSL + Cursor): use the forwarded port from the IDE (e.g. 3047), not 3000.
NEXT_PUBLIC_APP_URL=http://localhost:3047


# -----------------------------------------------------------------------------
# 2) NETWORK SWITCH (Intuition on-chain + wallet)
# -----------------------------------------------------------------------------
# Single switch — change ONE line to move between testnet and mainnet.
# RPC, GraphQL, explorer, portal, and wallet chain are picked automatically.
#
#   testnet → tTRUST, chain 13579 (local development)
#   mainnet → TRUST,  chain 1155  (production)
#
INTUITION_NETWORK=testnet

# Optional override (defaults match INTUITION_NETWORK — set if you use a custom RPC)
INTUITION_RPC_URL=https://testnet.rpc.intuition.systems/http

# Browser wallet: auto-mirrored from INTUITION_NETWORK via next.config.ts.
# Only set these if you need an explicit override:
# NEXT_PUBLIC_INTUITION_NETWORK=testnet
# NEXT_PUBLIC_INTUITION_RPC_URL=https://testnet.rpc.intuition.systems/http

# Optional: WalletConnect project id (https://cloud.walletconnect.com/)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Production (uncomment and replace testnet values above) ---
# INTUITION_NETWORK=mainnet
# INTUITION_RPC_URL=https://rpc.intuition.systems/http
# NEXT_PUBLIC_APP_URL=https://your-domain.com


# -----------------------------------------------------------------------------
# 3) ON-CHAIN PUBLISH
# -----------------------------------------------------------------------------
# The dapp publishes with the USER's connected wallet (they sign & pay).
# INTUITION_PRIVATE_KEY is optional and ONLY for maintainer scripts
# (migrate:batch, publish:one, etc.) — not used by the web UI.
#
# INTUITION_PRIVATE_KEY=0x...

# IPFS pinning before atom creation (server-only secrets — pick one).
# Preferred: Intuition gated pin API
#   Endpoint: https://pin.intuition.systems/v1/graphql (header: apikey)
#   Request key: https://forms.gle/7mhm55dFQzvyBLyG9
INTUITION_PIN_API_KEY=

# Temporary fallback while waiting for Intuition key (Pinata JWT):
#   https://app.pinata.cloud → API Keys → create JWT with pinJSON
# PINATA_JWT=
# PINATA_API_JWT=   # alias accepted

# Optional: wait for GraphQL indexer after writes (milliseconds)
# INTUITION_INDEXER_WAIT_MS=3000


# -----------------------------------------------------------------------------
# 4) AI BRAINSTORM
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo
ASSIST_ENABLED=true


# -----------------------------------------------------------------------------
# 5) GITHUB — bot fallback (optional, maintainer / CI only)
# -----------------------------------------------------------------------------
# Production visitors use OAuth (section 7). This block is for intuition-box
# maintainers or CI when no user session is present — keep commented in public deploys.
#
# GITHUB_TOKEN=ghp_YOUR_ORG_PAT
# GITHUB_PUBLISH_REPO=intuition-box/ideas

# Legacy alias (workshop scripts only) — prefer GITHUB_PUBLISH_REPO
# GITHUB_PR_REPO=intuition-box/ideas


# -----------------------------------------------------------------------------
# 6) GITHUB PR TARGET — upstream catalog (official production values)
# -----------------------------------------------------------------------------
# Target repo for the deployed dapp. Each contributor forks this repo via OAuth,
# pushes a branch on their fork, then opens a PR into intuition-box/ideas.
#
#   fork:  github.com/{user}/ideas        (auto-created from intuition-box/ideas)
#   PR:    {user}:branch  →  intuition-box/ideas:main
#
# intuition-box maintainers: use these values as-is when deploying the official dapp.
#
GITHUB_TARGET_REPO=intuition-box/ideas
GITHUB_BASE_BRANCH=main

# Local dev without write access to intuition-box/ideas — override to your fork:
# GITHUB_TARGET_REPO=your-user/ideas
# GITHUB_BASE_BRANCH=main


# -----------------------------------------------------------------------------
# 7) GITHUB OAUTH — user PRs (required for production dapp)
# -----------------------------------------------------------------------------
# Recommended for the official intuition-box deployment. Contributors sign in
# with GitHub; the server never stores their token in the browser (httpOnly cookie).
#
# Flow:
#   1. User clicks "Sign in with GitHub" in the Publish tab
#   2. Browser → /api/auth/github/login → GitHub (scope: public_repo)
#   3. GitHub → /api/auth/github/callback on THIS app (must match OAuth App)
#   4. Server stores an httpOnly session cookie (signed with SESSION_SECRET)
#   5. User clicks "Open GitHub PR" → server uses THEIR token to fork, push, PR
#
# Create OAuth App: https://github.com/settings/developers → New OAuth App
#   Homepage URL           → same as NEXT_PUBLIC_APP_URL
#   Authorization callback → {NEXT_PUBLIC_APP_URL}/api/auth/github/callback
#                           (exact match — no trailing slash, http vs https matters)
#
GITHUB_OAUTH_CLIENT_ID=Ov23liYOUR_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Signs the session cookie — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Only if callback URL differs from {NEXT_PUBLIC_APP_URL}/api/auth/github/callback
# GITHUB_OAUTH_CALLBACK_URL=

INTUITION_NETWORK=testnet
INTUITION_PRIVATE_KEY=0xYOUR_64_CHAR_HEX_PRIVATE_KEY
INTUITION_RPC_URL=https://testnet.rpc.intuition.systems/http

# Optional: lets the dapp create PR branches/files automatically.
# Without these, the Prepare screen still produces Markdown and gh fallback commands.
GITHUB_TOKEN=ghp_YOUR_TOKEN
GITHUB_TARGET_REPO=intuition-box/ideas
GITHUB_PUBLISH_REPO=YOUR_USER_OR_ORG/ideas
GITHUB_BASE_BRANCH=main

INTUITION_NETWORK=testnet
INTUITION_RPC_URL=https://testnet.rpc.intuition.systems/http

# AI brainstorm (Bounty 3B) + optional workshop assist
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ASSIST_ENABLED=true

# GitHub PR from Prepare (mission flow)
GITHUB_TOKEN=ghp_YOUR_TOKEN
GITHUB_TARGET_REPO=intuition-box/ideas
GITHUB_PUBLISH_REPO=YOUR_USER_OR_ORG/ideas
GITHUB_BASE_BRANCH=main

# On-chain publish from Prepare (server wallet)
INTUITION_PRIVATE_KEY=0x...

# Workshop-only: PR without on-chain from workshop UI
# GITHUB_PR_REPO=YOUR_USER/your-ideas-sandbox

INTUITION_NETWORK=testnet
# Wallet serveur pour publier depuis Prepare (testnet tTRUST requis)
INTUITION_PRIVATE_KEY=0xYOUR_64_CHAR_HEX_PRIVATE_KEY
INTUITION_RPC_URL=https://testnet.rpc.intuition.systems/http

# Assistant IA (atelier / triples)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ASSIST_ENABLED=true

# Publication GitHub (optionnel — sinon commandes manuelles)
GITHUB_TOKEN=ghp_...
GITHUB_TARGET_REPO=intuition-box/ideas
GITHUB_PUBLISH_REPO=YOUR_USER/ideas
GITHUB_BASE_BRANCH=main

INTUITION_NETWORK=testnet
# Graph read (research / inspect) — no on-chain publish from the workshop
INTUITION_RPC_URL=https://testnet.rpc.intuition.systems/http

# Assistant IA (atelier / triples)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ASSIST_ENABLED=true

# Publication GitHub (optionnel — sinon dépôt manuel via l’éditeur web)
GITHUB_TOKEN=ghp_...
GITHUB_BASE_BRANCH=main

# Production : commit sur ton fork → PR vers intuition-box (pas de branche à créer à la main)
# GITHUB_TARGET_REPO=intuition-box/ideas
# GITHUB_PUBLISH_REPO=YOUR_USER/ideas-fork

# Sandbox : même repo pour commit + PR (tests locaux)
# GITHUB_PR_REPO=YOUR_USER/your-ideas-sandbox
# GITHUB_BASE_BRANCH=feat/workshop-v2

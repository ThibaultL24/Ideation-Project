INTUITION_NETWORK=testnet
INTUITION_RPC_URL=https://testnet.rpc.intuition.systems/http

# URL publique de la dapp (prod : https://votre-domaine.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth GitHub — modèle utilisateur (recommandé en production)
# 1) Créer une OAuth App : https://github.com/settings/developers
#    - Homepage URL : NEXT_PUBLIC_APP_URL
#    - Callback URL : http://localhost:3000/api/auth/github/callback (ou prod)
# 2) Scope demandé : public_repo (fork + PR vers intuition-box/ideas)
# 3) SESSION_SECRET : chaîne aléatoire ≥ 16 caractères (signe le cookie session)
GITHUB_OAUTH_CLIENT_ID=Ov23liYOUR_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
# Optionnel si différent de NEXT_PUBLIC_APP_URL/api/auth/github/callback
# GITHUB_OAUTH_CALLBACK_URL=
SESSION_SECRET=change-me-to-a-long-random-string

# AI brainstorm (Bounty 3B)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ASSIST_ENABLED=true

GITHUB_TARGET_REPO=intuition-box/ideas
GITHUB_BASE_BRANCH=main

# On-chain publish (server wallet, 0x + 64 hex chars)
INTUITION_PRIVATE_KEY=0x...
# Optional: wait for GraphQL indexer after writes (ms)
INTUITION_INDEXER_WAIT_MS=3000

# Fallback serveur (optionnel, outil interne / CI — pas pour les visiteurs)
# GITHUB_TOKEN=ghp_YOUR_TOKEN
# GITHUB_PUBLISH_REPO=YOUR_GITHUB_USERNAME/ideas
